{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imjw-blog-analytics",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "imjwoo.com/api/analytics/*",
      "zone_id": "REPLACE_WITH_CLOUDFLARE_ZONE_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imjw-blog-analytics",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://imjwoo.com"
  }
}
